# Public API base URL, not a secret. Used for forms, software and careers.
# Copy to .env.local. Leave unset for disabled forms and the catalogue explanation.
# Restart dev or rebuild after changes. Builds never connect to Strapi.
PUBLIC_STRAPI_URL=http://localhost:1337

# Production builds are indexable by default. Set this to false for any public
# branch preview or staging deployment so every normal page stays noindex.
SITE_INDEXING=false
