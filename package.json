{
  "name": "indothai-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "capture:reference": "node scripts/capture-reference.mjs",
    "capture:local": "npm run build && node scripts/capture-local.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.10",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
