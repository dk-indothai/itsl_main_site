---
import { links } from '../../data/site';

const destination = links.shareholderRelation;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex, nofollow" />
    <title>Redirecting to Shareholder Relation - IndoThai</title>
    <script is:inline define:vars={{ destination }}>
      const source = new URL(window.location.href);
      const target = new URL(destination, window.location.origin);
      const parameter = 'shareholder_type';

      if (source.searchParams.has(parameter)) {
        target.searchParams.set(
          parameter,
          source.searchParams.get(parameter) ?? '',
        );
      }

      window.location.replace(`${target.pathname}${target.search}`);
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={destination}>Shareholder Relation</a>.
    </p>
  </body>
</html>
