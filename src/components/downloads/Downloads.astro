---
import { PUBLIC_STRAPI_URL } from 'astro:env/client';
import { site } from '../../data/site';

let apiBase = '';
try {
  const url = new URL(PUBLIC_STRAPI_URL ?? '');
  if (
    ['http:', 'https:'].includes(url.protocol) &&
    !url.username &&
    !url.password &&
    !url.search &&
    !url.hash
  )
    apiBase = url.href.replace(/\/$/, '');
} catch {
  // Invalid/missing public configuration keeps the explanatory fallback visible.
}
---

<section
  class="downloads page-shell"
  aria-labelledby="downloads-title"
  data-downloads
  data-api-base={apiBase}
>
  <h1 id="downloads-title">Software Downloads</h1>
  <div
    class="category-filters"
    role="group"
    aria-label="Software categories"
    data-filters
  >
    <button
      type="button"
      class="category-filter"
      aria-pressed="true"
      aria-controls="software-list"
      data-category=""
      disabled>All Categories</button
    >
  </div>
  <div class="catalogue-feedback">
    <p role="status" aria-atomic="true" data-status>
      {
        apiBase
          ? 'Enable JavaScript to load software downloads.'
          : 'Software downloads are not configured yet. Please contact us for assistance.'
      }
    </p>
    <button type="button" class="action retry" data-retry hidden>Retry</button>
  </div>
  <ul
    id="software-list"
    class="software-grid"
    aria-label="Software downloads"
    data-software-list
  >
  </ul>
  <p class="downloads-help">
    Need help? Call <a href={site.helpdesk.href}>{site.helpdesk.label}</a> or
    {' '}<a href={`mailto:${site.marketingEmail}`}>{site.marketingEmail}</a>.
  </p>

  <template data-filter-template>
    <button
      type="button"
      class="category-filter"
      aria-pressed="false"
      aria-controls="software-list"
      data-category></button>
  </template>
  <template data-card-template>
    <li class="software-card">
      <h2 data-name></h2>
      <p class="software-description" data-description hidden></p>
      <div class="file-meta">
        <p class="file-name" data-file-details hidden>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            ><path d="M14 3H6v18h12V7l-4-4Z M14 3v5h4 M9 12h6 M9 16h6"
            ></path></svg
          >
          <span class="sr-only">File: </span><span data-file-name></span>
        </p>
        <p class="file-size" data-size hidden>
          <span class="sr-only">File size: </span><span data-size-text></span>
        </p>
      </div>
      <a
        class="action download-link"
        target="_blank"
        rel="noopener noreferrer"
        data-download
        hidden
      >
        Download
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5"></path></svg
        >
        <span class="sr-only" data-link-label></span>
      </a>
      <p class="download-unavailable" data-unavailable>Download unavailable</p>
    </li>
  </template>
</section>

<script>
  interface Artifact {
    name?: string;
    ext?: string;
    url?: string;
    size?: number;
  }
  // Both collections have a name and ID; the remaining fields belong to software.
  interface CatalogueEntry {
    documentId: string;
    name?: string | null;
    description?: string | null;
    artifact?: Artifact | Artifact[] | null;
    software_category?: { documentId: string } | null;
  }
  interface ListingPage {
    data: CatalogueEntry[];
    meta: { pagination: { page: number; pageCount: number } };
  }

  const root = document.querySelector<HTMLElement>('[data-downloads]');
  if (root?.dataset.apiBase) {
    const apiBase = root.dataset.apiBase;
    const filters = root.querySelector<HTMLElement>('[data-filters]')!;
    const allButton = filters.querySelector('button')!;
    const list = root.querySelector<HTMLUListElement>('[data-software-list]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const retry = root.querySelector<HTMLButtonElement>('[data-retry]')!;
    const cardTemplate = root.querySelector<HTMLTemplateElement>(
      '[data-card-template]',
    )!;
    const filterTemplate = root.querySelector<HTMLTemplateElement>(
      '[data-filter-template]',
    )!;
    let loading = false;
    const invalidResponse =
      'The download service returned an invalid response. Please try again.';

    // 1. Load every API page. Nothing is displayed until both collections succeed.
    async function loadPages(
      collection: 'software-categories' | 'softwares',
      signal: AbortSignal,
    ): Promise<CatalogueEntry[]> {
      const records: CatalogueEntry[] = [];
      let pageCount = 1;
      for (let page = 1; page <= pageCount; page++) {
        const url = new URL(`${apiBase}/api/${collection}`);
        url.searchParams.set('pagination[page]', String(page));
        url.searchParams.set('pagination[pageSize]', '100');
        url.searchParams.set('sort[0]', 'name:asc');
        url.searchParams.set('sort[1]', 'documentId:asc');
        if (collection === 'softwares') {
          url.searchParams.set('populate[0]', 'artifact');
          url.searchParams.set('populate[1]', 'software_category');
        }
        const response = await fetch(url, {
          signal,
          credentials: 'omit',
          referrerPolicy: 'no-referrer',
          cache: 'no-store',
        });
        if (!response.ok) {
          if ([401, 403].includes(response.status))
            throw new Error(
              'Software downloads are not available to the public yet. Please contact us or try again later.',
            );
          if (response.status === 429)
            throw new Error(
              'Too many requests. Please wait a moment before trying again.',
            );
          throw new Error(
            'The download service is unavailable. Please try again later.',
          );
        }
        const result: ListingPage = await response.json();
        const pagination = result?.meta?.pagination;
        // Reject broken pagination instead of treating a failed request as empty.
        if (
          !Array.isArray(result?.data) ||
          pagination?.page !== page ||
          !Number.isInteger(pagination?.pageCount) ||
          pagination.pageCount < 0
        )
          throw new Error(invalidResponse);

        pageCount = pagination.pageCount;
        if (pageCount === 0) {
          if (page !== 1 || result.data.length)
            throw new Error(invalidResponse);
        } else if (pageCount < page || !result.data.length) {
          throw new Error(invalidResponse);
        }

        for (const item of result.data) {
          if (
            !item ||
            typeof item.documentId !== 'string' ||
            !item.documentId ||
            (item.name != null && typeof item.name !== 'string') ||
            (item.description != null &&
              typeof item.description !== 'string') ||
            (item.artifact != null && typeof item.artifact !== 'object') ||
            (item.software_category != null &&
              typeof item.software_category.documentId !== 'string')
          )
            throw new Error(invalidResponse);
          records.push(item);
        }
      }
      return records.sort(
        (a, b) =>
          (a.name ?? '').localeCompare(b.name ?? '', 'en-IN', {
            sensitivity: 'base',
            numeric: true,
          }) || a.documentId.localeCompare(b.documentId),
      );
    }

    function fileUrl(value: unknown): string | null {
      if (typeof value !== 'string' || !value.trim()) return null;
      try {
        const url = new URL(value, `${apiBase}/`);
        return ['http:', 'https:'].includes(url.protocol) &&
          !url.username &&
          !url.password
          ? url.href
          : null;
      } catch {
        return null;
      }
    }

    function fileName(
      file: Artifact | null | undefined,
      href: string | null,
    ): string {
      let name = typeof file?.name === 'string' ? file.name.trim() : '';
      if (!name && href) {
        name = new URL(href).pathname.split('/').pop() ?? '';
        try {
          name = decodeURIComponent(name);
        } catch {
          /* Keep an undecodable filename as supplied. */
        }
      }
      const extension =
        typeof file?.ext === 'string' && /^\.[a-z\d.]+$/i.test(file.ext)
          ? file.ext
          : '';
      if (
        name &&
        extension &&
        !name.toLowerCase().endsWith(extension.toLowerCase())
      )
        name += extension;
      return name;
    }

    // 2. Fill the HTML template once per software entry, using plain text only.
    function createCard(item: CatalogueEntry) {
      // Clone authored markup so Astro's scoped styles apply to dynamic cards too.
      const card = cardTemplate.content.firstElementChild!.cloneNode(
        true,
      ) as HTMLLIElement;
      card.dataset.category = item.software_category?.documentId ?? '';
      const name = item.name?.trim() || 'Unnamed software';
      card.querySelector('[data-name]')!.textContent = name;
      const description = card.querySelector('[data-description]')!;
      description.textContent = item.description ?? '';
      description.toggleAttribute('hidden', !item.description?.trim());
      // Attachment order is significant: never substitute a later file.
      const file = Array.isArray(item.artifact)
        ? item.artifact[0]
        : item.artifact;
      const href = fileUrl(file?.url);
      const filename = fileName(file, href);
      card.querySelector('[data-file-name]')!.textContent = filename;
      card
        .querySelector('[data-file-details]')!
        .toggleAttribute('hidden', !filename);
      if (href) {
        const link = card.querySelector('a')!;
        link.href = href;
        link.hidden = false;
        card.querySelector('[data-link-label]')!.textContent =
          ` ${name} (opens in a new tab)`;
        card.querySelector('[data-unavailable]')!.setAttribute('hidden', '');
      }
      if (
        typeof file?.size === 'number' &&
        Number.isFinite(file.size) &&
        file.size >= 0
      ) {
        // Strapi reports upload sizes in kilobytes.
        const megabytes = file.size >= 1000;
        const size = megabytes ? file.size / 1000 : file.size;
        card.querySelector('[data-size-text]')!.textContent =
          `${size.toLocaleString('en-IN', { maximumFractionDigits: 2 })} ${megabytes ? 'MB' : 'KB'}`;
        card.querySelector('[data-size]')!.removeAttribute('hidden');
      }
      return card;
    }

    // 3. Filter the existing cards. Hidden cards and links leave the tab order.
    function filterCards(categoryId = '') {
      let count = 0;
      for (const card of list.querySelectorAll('li')) {
        card.hidden = !!categoryId && card.dataset.category !== categoryId;
        if (!card.hidden) count++;
      }
      for (const button of filters.querySelectorAll('button')) {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.category === categoryId),
        );
      }
      status.textContent = count
        ? `${count} software ${count === 1 ? 'download' : 'downloads'}.`
        : 'No software yet.';
    }

    async function loadCatalogue() {
      if (loading) return;
      const restoreFocus = document.activeElement === retry;
      loading = true;
      retry.disabled = true;
      allButton.disabled = true;
      list.setAttribute('aria-busy', 'true');
      status.textContent = 'Loading software downloads…';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20_000);
      try {
        const [categories, entries] = await Promise.all([
          loadPages('software-categories', controller.signal),
          loadPages('softwares', controller.signal),
        ]);
        list.replaceChildren(...entries.map(createCard));
        filters.replaceChildren(allButton);
        for (const category of categories) {
          const button = filterTemplate.content.firstElementChild!.cloneNode(
            true,
          ) as HTMLButtonElement;
          button.dataset.category = category.documentId;
          button.textContent = category.name?.trim() || 'Unnamed category';
          button.addEventListener('click', () =>
            filterCards(category.documentId),
          );
          filters.append(button);
        }
        allButton.disabled = false;
        filterCards();
        if (
          restoreFocus &&
          (document.activeElement === document.body ||
            document.activeElement === retry)
        )
          allButton.focus();
        retry.hidden = true;
      } catch (error) {
        let message = 'Could not load software downloads. Please try again.';
        if (error instanceof Error) message = error.message;
        if (error instanceof SyntaxError) message = invalidResponse;
        if (error instanceof TypeError)
          message =
            'Could not connect to the download service. Please check your connection and try again.';
        if (controller.signal.aborted)
          message = 'Loading took too long. Please try again.';
        status.textContent = message;
        retry.hidden = false;
      } finally {
        window.clearTimeout(timeout);
        controller.abort();
        list.setAttribute('aria-busy', 'false');
        loading = false;
        retry.disabled = false;
      }
    }

    allButton.addEventListener('click', () => filterCards());
    retry.addEventListener('click', loadCatalogue);
    void loadCatalogue();
  }
</script>

<style>
  @reference '../../styles/global.css';
  .downloads {
    padding-top: var(--space-2xl);
    font-size: var(--text-small);
  }
  h1 {
    margin-bottom: var(--space-xl);
    font-size: var(--text-section);
    line-height: var(--leading-section);
  }
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    border-bottom: var(--border-thin) solid var(--color-subtle);
  }
  .category-filter {
    min-height: var(--target-min);
    max-width: 100%;
    padding: var(--space-sm) var(--space-xs);
    border-bottom: var(--border-focus) solid transparent;
    font-weight: var(--font-weight-medium);
    overflow-wrap: anywhere;
  }
  .category-filter[aria-pressed='true'] {
    color: var(--color-brand);
    border-bottom-color: currentColor;
  }
  .category-filter:hover:not(:disabled) {
    color: var(--color-brand-hover);
  }
  .category-filter:disabled {
    cursor: not-allowed;
    color: var(--color-muted);
  }
  .catalogue-feedback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-md);
    color: var(--color-muted);
  }
  .software-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }
  .software-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: var(--border-thin) solid var(--color-subtle);
    border-radius: var(--radius-testimonial);
    box-shadow: var(--shadow-card);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .software-card h2 {
    font-size: var(--text-content-card);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-body);
  }
  .software-description {
    white-space: pre-line;
  }
  .file-meta {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    width: 100%;
    color: var(--color-muted);
    font-size: var(--text-caption);
  }
  /* Do not leave a blank metadata row when neither value is available. */
  .file-meta:has(.file-name[hidden]):has(.file-size[hidden]) {
    display: none;
  }
  .file-name {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    min-width: 0;
  }
  .file-size {
    flex-shrink: 0;
    margin-left: auto;
    white-space: nowrap;
  }
  .file-name:not([hidden]) + .file-size {
    padding-left: var(--space-sm);
    border-left: var(--border-thin) solid var(--color-subtle);
  }
  svg {
    width: var(--icon-control);
    height: var(--icon-control);
    flex-shrink: 0;
  }
  .download-link,
  .download-unavailable {
    margin-top: auto;
    width: 100%;
  }
  .download-unavailable {
    min-height: var(--target-min);
    display: flex;
    align-items: center;
    color: var(--color-muted);
  }
  .download-link {
    gap: var(--space-xs);
  }
  .downloads-help {
    margin-top: var(--space-xl);
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .downloads-help a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: var(--focus-offset);
  }
  [hidden] {
    display: none;
  }
  @media (width < theme(--breakpoint-desktop)) {
    .software-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width < theme(--breakpoint-tablet)) {
    .software-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
