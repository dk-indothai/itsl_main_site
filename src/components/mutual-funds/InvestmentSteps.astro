---
import { Image } from 'astro:assets';
import { investmentSteps, financialGoals } from '../../data/mutual-funds';
---

<section class="page-shell content-shell" aria-labelledby="fund-steps-title">
  <h2 id="fund-steps-title" class="content-title">
    How To Start In Mutual Funds?
  </h2>
  <p class="steps-introduction">{financialGoals}</p>
  <ol class="investment-steps" role="list">
    {
      investmentSteps.map((step, index) => (
        <li>
          <Image src={step.icon} alt={`Step ${index + 1}`} />
          <h3>{step.title}</h3>
        </li>
      ))
    }
  </ol>
</section>
<style>
  .steps-introduction {
    max-width: var(--fund-step-max);
    margin-inline: auto;
    text-align: center;
  }
  .investment-steps {
    max-width: var(--fund-step-max);
    margin: var(--space-2xl) auto 0;
    display: grid;
    gap: var(--space-xl);
  }
  li {
    display: grid;
    grid-template-columns: var(--fund-step-icon) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-xl);
  }
  img {
    width: var(--fund-step-icon);
  }
  h3 {
    display: flex;
    align-items: center;
    min-height: var(--fund-step-height);
    border: var(--border-thin) solid var(--color-subtle);
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-card);
    font-family: var(--font-body);
    font-size: var(--fund-step-text);
    font-weight: var(--font-weight-normal);
  }
  @media (width < theme(--breakpoint-tablet)) {
    li {
      gap: var(--space-md);
    }
    h3 {
      padding: var(--space-md);
    }
  }
  @reference '../../styles/tokens.css';
</style>
