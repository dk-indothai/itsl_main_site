---
import { Image } from 'astro:assets';
import plane from '../../assets/images/mutual-funds/flight-plane.svg';
import { nriBenefits } from '../../data/mutual-funds';
---

<section class="nri-support" aria-labelledby="nri-title">
  <div class="nri-flight" aria-hidden="true">
    <svg
      class="nri-flight-path"
      viewBox="0 0 1000 400"
      preserveAspectRatio="none"
      focusable="false"
    >
      <path
        d="M0 290 C150 340 180 65 330 65 S520 180 620 220 S790 340 850 135 S930 60 1000 32"
        vector-effect="non-scaling-stroke"></path>
    </svg>
    <Image class="nri-flight-plane" src={plane} alt="" />
  </div>
  <div class="nri-heading">
    <h2 id="nri-title" class="page-shell">
      Why Indothai is the Premier Partner for <span
        >NRI to Invest in Mutual Fund</span
      >
    </h2>
  </div>
  <ul class="page-shell content-shell content-grid nri-cards" role="list">
    {
      nriBenefits.map((item) => (
        <li>
          <>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </>
        </li>
      ))
    }
  </ul>
</section>
<style>
  .nri-support {
    position: relative;
    isolation: isolate;
  }
  .nri-heading {
    position: relative;
    z-index: var(--nri-content-layer);
    text-align: center;
    margin-bottom: var(--space-2xl);
  }
  .nri-heading h2 {
    color: var(--color-ink);
    max-width: var(--nri-title-max);
    font-size: var(--text-fund-nri);
    font-weight: var(--font-weight-normal);
    line-height: var(--fund-nri-line-height);
    background: var(--color-white);
  }
  .nri-heading h2 span {
    display: block;
    color: var(--color-brand);
  }
  .nri-flight {
    position: absolute;
    z-index: var(--nri-flight-layer);
    inset: 0 0 auto;
    height: var(--nri-flight-height);
    overflow: clip;
    pointer-events: none;
  }
  .nri-flight-path {
    position: absolute;
    inset: 0 calc(var(--nri-plane-size) / 2);
    display: block;
    width: calc(100% - var(--nri-plane-size));
    height: 100%;
    fill: none;
    stroke: var(--color-border);
    stroke-width: var(--nri-flight-stroke);
    stroke-dasharray: var(--nri-flight-dash);
    stroke-linecap: round;
    opacity: var(--nri-flight-opacity);
  }
  .nri-flight-plane {
    position: absolute;
    left: calc(100% - var(--nri-plane-size) / 2);
    top: var(--nri-plane-y);
    translate: -50% -50%;
    width: var(--nri-plane-size);
    height: var(--nri-plane-size);
  }
  .nri-cards {
    position: relative;
    z-index: var(--nri-content-layer);
  }
  .nri-cards li {
    background: var(--color-white);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-xl) var(--space-md);
    text-align: center;
  }
  h3 {
    font-weight: var(--font-weight-semibold);
    color: var(--color-brand);
    font-size: var(--text-content-card);
    margin-bottom: var(--space-xs);
  }
  p {
    font-size: var(--text-small);
  }
</style>
