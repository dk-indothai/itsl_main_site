---
import { investorsApi } from '../../data/investors';
import { site } from '../../data/site';
---

<section
  class="shareholder-relations page-shell"
  aria-labelledby="shareholder-title"
  data-shareholder-relations
  data-api={investorsApi}
>
  <h1 id="shareholder-title">Shareholder Relation</h1>
  <p class="intro">
    Browse shareholder documents and company disclosures by category.
  </p>
  <div class="category-control">
    <label for="shareholder-category">Document category</label>
    <select id="shareholder-category" data-category disabled>
      <option value="">All Categories</option>
    </select>
  </div>
  <div class="feedback">
    <p role="status" aria-atomic="true" data-shareholder-status>
      {
        investorsApi
          ? 'Enable JavaScript to load shareholder documents.'
          : 'Shareholder documents are not configured yet. Please contact us for assistance.'
      }
    </p>
    <button type="button" class="action" data-shareholder-retry hidden>
      Retry
    </button>
  </div>
  <ul class="relation-list" data-relation-list aria-busy="false"></ul>
  <p class="contact-alternatives">
    Need help? <a href={site.telephone.href}>{site.telephone.label}</a> or <a
      href={`mailto:${site.complianceEmail}`}>{site.complianceEmail}</a
    >.
  </p>
  <template data-relation-template>
    <li class="relation-card">
      <div>
        <h2 data-relation-title></h2>
        <p class="file-meta" data-file-meta hidden>
          <span data-file-name></span><span aria-hidden="true">·</span><span
            data-file-size></span>
        </p>
      </div>
      <a
        class="action action-outline"
        target="_blank"
        rel="noopener noreferrer"
        data-download
        hidden>Download<span class="sr-only" data-download-label></span></a
      >
      <p class="unavailable" data-unavailable>Download unavailable</p>
    </li>
  </template>
</section>

<script>
  import {
    getShareholderCategories,
    getShareholderRelations,
    investorError,
    publicFileUrl,
    shareholderFileName,
    shareholderFileSize,
  } from '../../data/investors';

  const root = document.querySelector<HTMLElement>(
    '[data-shareholder-relations]',
  )!;
  const select = root.querySelector<HTMLSelectElement>('[data-category]')!;
  const list = root.querySelector<HTMLUListElement>('[data-relation-list]')!;
  const status = root.querySelector<HTMLElement>('[data-shareholder-status]')!;
  const retry = root.querySelector<HTMLButtonElement>(
    '[data-shareholder-retry]',
  )!;
  const template = root.querySelector<HTMLTemplateElement>(
    '[data-relation-template]',
  )!;
  let loading = false;

  function filterRelations() {
    let visible = 0;
    for (const card of list.children) {
      if (!(card instanceof HTMLElement)) continue;
      card.hidden = !!select.value && card.dataset.category !== select.value;
      if (!card.hidden) visible++;
    }
    status.textContent = visible
      ? `${visible} shareholder ${visible === 1 ? 'document' : 'documents'}.`
      : 'No shareholder documents yet.';
  }

  async function loadRelations() {
    if (loading) return;
    loading = true;
    retry.disabled = true;
    select.disabled = true;
    list.setAttribute('aria-busy', 'true');
    status.textContent = 'Loading shareholder documents…';
    try {
      const [categories, relations] = await Promise.all([
        getShareholderCategories(),
        getShareholderRelations(),
      ]);
      select.replaceChildren(new Option('All Categories', ''));
      for (const category of categories)
        select.add(new Option(category.name, category.documentId));

      const cards = relations.map((relation) => {
        const card = template.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLElement;
        card.dataset.category =
          relation.shareholder_relation_category?.documentId ?? '';
        card.querySelector('[data-relation-title]')!.textContent =
          relation.title;
        const href = publicFileUrl(relation.file);
        const filename = shareholderFileName(relation.file);
        const size = shareholderFileSize(relation.file);
        const meta = card.querySelector<HTMLElement>('[data-file-meta]')!;
        card.querySelector('[data-file-name]')!.textContent = filename;
        card.querySelector('[data-file-size]')!.textContent = size;
        meta.hidden = !filename && !size;
        const separator = meta.querySelector<HTMLElement>('[aria-hidden]')!;
        separator.hidden = !filename || !size;
        if (href) {
          const link =
            card.querySelector<HTMLAnchorElement>('[data-download]')!;
          link.href = href;
          link.hidden = false;
          card.querySelector('[data-download-label]')!.textContent =
            ` ${relation.title} (opens in a new tab)`;
          card.querySelector('[data-unavailable]')!.setAttribute('hidden', '');
        }
        return card;
      });
      list.replaceChildren(...cards);
      select.disabled = false;
      filterRelations();
      retry.hidden = true;
    } catch (error) {
      status.textContent = investorError(error);
      retry.hidden = false;
    } finally {
      list.setAttribute('aria-busy', 'false');
      retry.disabled = false;
      loading = false;
    }
  }

  select.addEventListener('change', filterRelations);
  retry.addEventListener('click', loadRelations);
  if (root.dataset.api) void loadRelations();
</script>

<style>
  @reference '../../styles/tokens.css';
  .shareholder-relations {
    max-width: var(--content-max);
  }
  h1 {
    font-size: var(--text-section);
    line-height: var(--leading-section);
  }
  .intro {
    max-width: var(--about-introduction-max);
    margin-top: var(--space-md);
    color: var(--color-muted);
  }
  .category-control {
    display: grid;
    gap: var(--space-xs);
    max-width: var(--investor-filter-max);
    margin-top: var(--space-xl);
    font-size: var(--text-small);
    font-weight: var(--font-weight-medium);
  }
  select {
    min-height: var(--target-min);
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-white);
    color: var(--color-body);
  }
  select:disabled {
    cursor: not-allowed;
    color: var(--color-muted);
  }
  .feedback {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-caption);
  }
  .relation-list {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .relation-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: var(--border-thin) solid var(--color-subtle);
    border-radius: var(--radius-testimonial);
    box-shadow: var(--shadow-card);
    overflow-wrap: anywhere;
  }
  .relation-card h2 {
    color: var(--color-brand);
    font-size: var(--text-content-card);
  }
  .file-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    color: var(--color-muted);
    font-size: var(--text-caption);
  }
  .relation-card .action {
    flex-shrink: 0;
  }
  .unavailable {
    flex-shrink: 0;
    color: var(--color-muted);
    font-size: var(--text-caption);
  }
  .contact-alternatives {
    margin-top: var(--space-xl);
    color: var(--color-muted);
    font-size: var(--text-caption);
    overflow-wrap: anywhere;
  }
  .contact-alternatives a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: var(--focus-offset);
  }
  [hidden] {
    display: none;
  }
  @media (width < theme(--breakpoint-tablet)) {
    .relation-card {
      align-items: flex-start;
      flex-direction: column;
      padding: var(--space-md);
    }
    .relation-card .action {
      width: 100%;
    }
  }
</style>
