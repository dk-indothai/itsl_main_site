---
import { investorsApi } from '../../data/investors';
import { site } from '../../data/site';
---

<section
  class="client-relations page-shell"
  aria-labelledby="client-relations-title"
  data-client-relations
  data-api={investorsApi}
>
  <h1 id="client-relations-title">Client Relation</h1>
  <p class="intro">
    Access IndoThai client policies, forms and investor information.
  </p>
  <div class="feedback">
    <p role="status" aria-atomic="true" data-client-relation-status>
      {
        investorsApi
          ? 'Enable JavaScript to load client relation documents.'
          : 'Client relation documents are not configured yet. Please contact us for assistance.'
      }
    </p>
    <button type="button" class="action" data-client-relation-retry hidden>
      Retry
    </button>
  </div>
  <ul class="document-list" data-client-relation-list aria-busy="false"></ul>
  <p class="contact-alternatives">
    Need help? <a href={site.telephone.href}>{site.telephone.label}</a> or <a
      href={`mailto:${site.complianceEmail}`}>{site.complianceEmail}</a
    >.
  </p>
  <template data-client-relation-template>
    <li class="document-row">
      <h2 data-client-relation-title></h2>
      <a
        class="download-link"
        target="_blank"
        rel="noopener noreferrer"
        data-client-relation-download
        hidden
      >
        <span>Download</span>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"></path>
        </svg>
        <span class="sr-only" data-client-relation-label></span>
      </a>
      <p class="unavailable" data-client-relation-unavailable>
        Download unavailable
      </p>
    </li>
  </template>
</section>

<script>
  import {
    getClientRelations,
    investorError,
    publicFileUrl,
  } from '../../data/investors';

  const root = document.querySelector<HTMLElement>('[data-client-relations]')!;
  const list = root.querySelector<HTMLUListElement>(
    '[data-client-relation-list]',
  )!;
  const status = root.querySelector<HTMLElement>(
    '[data-client-relation-status]',
  )!;
  const retry = root.querySelector<HTMLButtonElement>(
    '[data-client-relation-retry]',
  )!;
  const template = root.querySelector<HTMLTemplateElement>(
    '[data-client-relation-template]',
  )!;
  let loading = false;

  async function loadClientRelations() {
    if (loading) return;
    loading = true;
    retry.disabled = true;
    list.setAttribute('aria-busy', 'true');
    status.classList.remove('sr-only');
    status.textContent = 'Loading client relation documents…';
    try {
      const documents = await getClientRelations();
      const rows = documents.map((document) => {
        const row = template.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLElement;
        row.querySelector('[data-client-relation-title]')!.textContent =
          document.title;
        const href = publicFileUrl(document.file);
        if (href) {
          const link = row.querySelector<HTMLAnchorElement>(
            '[data-client-relation-download]',
          )!;
          link.href = href;
          link.hidden = false;
          row.querySelector('[data-client-relation-label]')!.textContent =
            ` ${document.title} (opens in a new tab)`;
          row
            .querySelector('[data-client-relation-unavailable]')!
            .setAttribute('hidden', '');
        }
        return row;
      });
      list.replaceChildren(...rows);
      status.textContent = documents.length
        ? 'Client relation documents loaded.'
        : 'No client relation documents yet.';
      status.classList.toggle('sr-only', documents.length > 0);
      retry.hidden = true;
    } catch (error) {
      status.classList.remove('sr-only');
      status.textContent = investorError(error);
      retry.hidden = false;
    } finally {
      list.setAttribute('aria-busy', 'false');
      retry.disabled = false;
      loading = false;
    }
  }

  retry.addEventListener('click', loadClientRelations);
  if (root.dataset.api) void loadClientRelations();
</script>

<style>
  @reference '../../styles/tokens.css';
  .client-relations {
    max-width: var(--content-max);
  }
  h1 {
    color: var(--color-brand);
    font-size: var(--text-section);
    line-height: var(--leading-section);
    text-align: center;
  }
  .intro {
    max-width: var(--about-introduction-max);
    margin: var(--space-md) auto 0;
    color: var(--color-muted);
    text-align: center;
  }
  .feedback {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-caption);
  }
  .document-list {
    display: grid;
    max-width: var(--about-introduction-max);
    gap: var(--space-md);
    margin: var(--space-xl) auto 0;
  }
  .document-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-white);
    overflow-wrap: anywhere;
  }
  .document-row h2 {
    flex: 1;
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    text-align: center;
  }
  .download-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--space-xs);
    min-height: var(--target-min);
    color: var(--color-brand);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
  }
  .download-link svg {
    width: var(--icon-control);
    height: var(--icon-control);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: var(--border-focus);
  }
  .download-link:hover span:first-child,
  .download-link:focus-visible span:first-child {
    text-decoration: underline;
    text-underline-offset: var(--focus-offset);
  }
  .unavailable {
    flex-shrink: 0;
    color: var(--color-muted);
    font-size: var(--text-caption);
  }
  .contact-alternatives {
    margin-top: var(--space-xl);
    color: var(--color-muted);
    font-size: var(--text-caption);
    text-align: center;
    overflow-wrap: anywhere;
  }
  .contact-alternatives a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: var(--focus-offset);
  }
  [hidden] {
    display: none;
  }
  @media (width < theme(--breakpoint-tablet)) {
    .document-row {
      align-items: stretch;
      flex-direction: column;
      gap: var(--space-sm);
      padding: var(--space-md);
    }
    .download-link {
      justify-content: center;
    }
  }
</style>
