---
import { investorNavigation } from '../../data/nav';

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav class="investor-page-nav" aria-label="Investor pages">
  <ul>
    {
      investorNavigation.children.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.href === current ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  :global(.investor-page),
  :global(.investor-navigation) {
    min-width: 0;
  }
  .investor-page-nav {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    padding: var(--space-sm);
    border-radius: var(--radius-panel);
    background: var(--color-brand);
    box-shadow: var(--shadow-panel);
  }
  ul {
    display: flex;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    flex-wrap: nowrap;
    gap: var(--space-xs);
    overflow-x: auto;
    scrollbar-color: var(--color-white) transparent;
    scrollbar-width: thin;
  }
  ul::-webkit-scrollbar {
    height: var(--space-xs);
  }
  ul::-webkit-scrollbar-thumb {
    border-radius: var(--radius-pill);
    background: var(--color-white);
  }
  ul::-webkit-scrollbar-track {
    background: transparent;
  }
  li {
    flex: 0 0 auto;
  }
  a {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-control);
    color: var(--color-white);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }
  a:hover {
    background: var(--color-brand-hover);
  }
  a[aria-current='page'] {
    background: var(--color-white);
    color: var(--color-brand);
  }
  a[aria-current='page']:hover {
    background: var(--color-white);
  }
</style>
