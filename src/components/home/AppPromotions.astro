---
import { Image } from 'astro:assets';
import { apps } from '../../data/home';
import StoreBadges from '../shared/StoreBadges.astro';
---

{
  apps.map((app, index) => (
    <section
      class:list={['app-section', { 'bg-soft app-invest': index === 1 }]}
      aria-labelledby={`app-${index}`}
    >
      <div class="page-shell app-layout">
        <h2 id={`app-${index}`}>
          <span>
            {index === 0 ? 'Start Trading With' : 'Invest in Mutual Funds With'}
          </span>
          {index === 0 ? <br /> : ' '}
          {app.name}
        </h2>
        <Image
          src={app.image}
          alt={app.alt}
          widths={[350, 550, 800]}
          sizes="(max-width: 767px) 90vw, 45vw"
          class="app-art"
        />
        <div class="app-copy">
          <p>{app.description}</p>
          <p class="download-label">Download our app from</p>
          <StoreBadges name={app.name} apple={app.apple} google={app.google} />
        </div>
      </div>
    </section>
  ))
}
<style>
  @reference "../../styles/tokens.css";
  .app-layout {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-rows: auto auto;
    align-content: center;
    column-gap: var(--space-xl);
  }
  .app-art {
    grid-column: 2;
    grid-row: 1 / 3;
    width: min(100%, var(--app-image-width));
    margin: auto;
  }
  .app-copy {
    grid-column: 1;
    font-size: var(--text-app-body);
  }
  h2 {
    grid-column: 1;
    align-self: end;
    font-size: var(--text-app);
    margin-bottom: var(--space-sm);
  }
  h2 span {
    color: var(--color-ink);
  }
  .download-label {
    margin-block: var(--space-xl) var(--space-md);
    font-size: var(--text-small);
    font-weight: var(--font-weight-medium);
  }
  .app-invest {
    border-radius: var(--radius-image) var(--radius-image) 0 0;
    padding-block: var(--space-section);
  }
  @media (width < theme(--breakpoint-tablet)) {
    .app-layout {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }
    .app-copy {
      padding-bottom: var(--space-md);
    }
    .app-art {
      width: 100%;
    }
    .app-invest h2 {
      font-size: var(--text-why);
    }
  }
</style>
