---
import { blogApi } from '../../data/blogs';
import { site } from '../../data/site';
---

<section class="blog-page page-shell" data-blog-list data-api={blogApi}>
  <header class="blog-heading">
    <h1>Blog</h1>
    <p>Insights, market perspectives and updates from IndoThai.</p>
  </header>
  <div class="feedback">
    <p role="status" aria-atomic="true" data-blog-status>
      {
        blogApi
          ? 'Enable JavaScript to load blog posts.'
          : 'Blog posts are not configured yet. Please contact us for assistance.'
      }
    </p>
    <button type="button" class="action" data-blog-retry hidden>Retry</button>
  </div>
  <ul class="post-list" aria-busy="false" data-post-list></ul>
  <p class="contact-alternatives">
    Need help? <a href={site.telephone.href}>{site.telephone.label}</a> or <a
      href={`mailto:${site.marketingEmail}`}>{site.marketingEmail}</a
    >.
  </p>

  <template data-post-template>
    <li>
      <article class="post-card">
        <a class="banner-link" data-banner-link hidden>
          <img data-banner alt="" loading="lazy" decoding="async" />
        </a>
        <div class="post-copy">
          <h2><a data-title-link></a></h2>
          <p class="excerpt" data-excerpt></p>
          <footer>
            <a class="read-more" data-read-more
              >Read More<span class="sr-only" data-read-more-label></span></a
            >
            <time data-date></time>
          </footer>
        </div>
      </article>
    </li>
  </template>
</section>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';
  import {
    blogError,
    blogImage,
    formatBlogDate,
    getBlogPosts,
  } from '../../data/blogs';

  const root = document.querySelector<HTMLElement>('[data-blog-list]')!;
  const list = root.querySelector<HTMLUListElement>('[data-post-list]')!;
  const status = root.querySelector<HTMLElement>('[data-blog-status]')!;
  const retry = root.querySelector<HTMLButtonElement>('[data-blog-retry]')!;
  const template = root.querySelector<HTMLTemplateElement>(
    '[data-post-template]',
  )!;
  let loading = false;

  function excerpt(markdown: string): string {
    const content = DOMPurify.sanitize(
      marked.parse(markdown, { async: false }),
      {
        ALLOWED_TAGS: [],
        ALLOWED_ATTR: [],
        KEEP_CONTENT: true,
        RETURN_DOM_FRAGMENT: true,
      },
    )
      .textContent?.replace(/\s+/g, ' ')
      .trim();
    if (!content) return '';
    const words = content.split(' ');
    return words.length > 45 ? `${words.slice(0, 45).join(' ')}…` : content;
  }

  async function loadPosts() {
    if (loading) return;
    const retryHadFocus = document.activeElement === retry;
    loading = true;
    retry.disabled = true;
    list.setAttribute('aria-busy', 'true');
    status.classList.remove('sr-only');
    status.textContent = 'Loading blog posts…';
    try {
      const posts = await getBlogPosts();
      const cards = posts.map((post) => {
        const card = template.content.firstElementChild!.cloneNode(
          true,
        ) as HTMLElement;
        const href = `/blog/post/?id=${encodeURIComponent(post.documentId)}`;
        for (const link of card.querySelectorAll<HTMLAnchorElement>(
          '[data-title-link], [data-read-more]',
        ))
          link.href = href;
        card.querySelector('[data-title-link]')!.textContent = post.title;
        card.querySelector('[data-read-more-label]')!.textContent =
          ` about ${post.title}`;
        card.querySelector('[data-excerpt]')!.textContent = excerpt(
          post.content,
        );
        const time = card.querySelector<HTMLTimeElement>('[data-date]')!;
        time.dateTime = post.publish_date;
        time.textContent = formatBlogDate(post.publish_date);

        const image = blogImage(post.banner);
        if (image) {
          const bannerLink =
            card.querySelector<HTMLAnchorElement>('[data-banner-link]')!;
          const banner = card.querySelector<HTMLImageElement>('[data-banner]')!;
          bannerLink.href = href;
          bannerLink.hidden = false;
          banner.src = image.url;
          banner.alt = image.alt;
          if (image.width) banner.width = image.width;
          if (image.height) banner.height = image.height;
        }
        return card;
      });
      list.replaceChildren(...cards);
      status.textContent = posts.length
        ? 'Blog posts loaded.'
        : 'No blog posts yet.';
      status.classList.toggle('sr-only', posts.length > 0);
      retry.hidden = true;
      if (retryHadFocus && posts.length)
        list.querySelector<HTMLAnchorElement>('a')?.focus();
    } catch (error) {
      status.classList.remove('sr-only');
      status.textContent = blogError(error);
      retry.hidden = false;
    } finally {
      loading = false;
      retry.disabled = false;
      list.setAttribute('aria-busy', 'false');
    }
  }

  status.tabIndex = -1;
  retry.addEventListener('click', loadPosts);
  if (root.dataset.api) void loadPosts();
</script>

<style>
  @reference '../../styles/tokens.css';
  .blog-page {
    max-width: var(--blog-content-max);
  }
  .blog-heading {
    text-align: center;
  }
  h1 {
    display: inline-block;
    padding-bottom: var(--space-xs);
    border-bottom: var(--border-focus) solid var(--color-brand);
    color: var(--color-ink);
    font-size: var(--text-content-heading);
    line-height: var(--leading-content-heading);
  }
  .blog-heading p {
    max-width: var(--about-introduction-max);
    margin: var(--space-md) auto 0;
    color: var(--color-muted);
  }
  .feedback {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    min-height: var(--target-min);
    margin-top: var(--space-xl);
    color: var(--color-muted);
    font-size: var(--text-caption);
    text-align: center;
  }
  .post-list {
    display: grid;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
  }
  .post-card {
    overflow: hidden;
    border: var(--border-thin) solid var(--color-panel-border);
    border-radius: var(--radius-card);
    background: var(--color-white);
    box-shadow: var(--shadow-panel);
  }
  .banner-link {
    display: block;
    overflow: hidden;
    background: var(--color-footer);
  }
  .banner-link img {
    display: block;
    width: 100%;
    max-height: var(--blog-banner-max-height);
    object-fit: cover;
  }
  .banner-link:hover img,
  .banner-link:focus-visible img {
    transform: scale(1.01);
  }
  .banner-link img {
    transition: transform var(--default-transition-duration)
      var(--default-transition-timing-function);
  }
  .post-copy {
    padding: var(--space-lg);
  }
  h2 {
    color: var(--color-body);
    font-size: var(--text-content-card);
    line-height: var(--leading-body);
  }
  h2 a:hover,
  h2 a:focus-visible {
    color: var(--color-brand);
    text-decoration: none;
  }
  .excerpt {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-small);
    line-height: var(--leading-body);
  }
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--space-md);
    border-radius: var(--radius-control);
    background: var(--color-brand);
    color: var(--color-white);
    font-family: var(--font-action);
    font-size: var(--text-caption);
  }
  .read-more:hover,
  .read-more:focus-visible {
    background: var(--color-brand-hover);
    text-decoration: none;
  }
  time,
  .contact-alternatives {
    color: var(--color-muted);
    font-size: var(--text-caption);
  }
  .contact-alternatives {
    margin-top: var(--space-xl);
    text-align: center;
  }
  .contact-alternatives a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: var(--focus-offset);
  }
  @media (width < theme(--breakpoint-small)) {
    .post-list {
      gap: var(--space-xl);
    }
    .post-copy {
      padding: var(--space-md);
    }
    footer {
      align-items: start;
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .banner-link img {
      transition: none;
    }
    .banner-link:hover img,
    .banner-link:focus-visible img {
      transform: none;
    }
  }
</style>
