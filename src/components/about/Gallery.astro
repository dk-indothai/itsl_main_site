---
import { Image } from 'astro:assets';
import { gallery } from '../../data/about';
---

<section class="page-shell content-shell" aria-labelledby="gallery-title">
  <h2 id="gallery-title" class="content-title">Gallery</h2>
  <ul class="gallery-grid" role="list">
    {
      gallery.map((item) => (
        <li>
          <Image
            src={item.image}
            alt={item.alt}
            widths={[500, 800, 1200]}
            sizes="(max-width: 767px) 90vw, 55vw"
            class="content-image"
          />
        </li>
      ))
    }
  </ul>
</section>
<style>
  @reference '../../styles/tokens.css';
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gallery-gap);
  }
  li:first-child {
    grid-column: span 7;
  }
  li:nth-child(2) {
    grid-column: span 5;
  }
  li:nth-child(3) {
    grid-column: 1 / -1;
  }
  li:nth-child(4) {
    grid-column: span 4;
  }
  li:last-child {
    grid-column: span 8;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (width < theme(--breakpoint-tablet)) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    .gallery-grid li {
      grid-column: 1;
    }
  }
</style>
