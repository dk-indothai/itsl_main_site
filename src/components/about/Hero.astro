---
import { Image } from 'astro:assets';
import background from '../../assets/images/about-us/about-bg.png';
import { aboutIntroduction } from '../../data/about';
---

<section class="about-hero" aria-labelledby="about-title">
  <Image
    src={background}
    alt=""
    widths={[640, 1024, 1600, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-photo"
  />
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="page-shell content-shell hero-copy">
    <h1 id="about-title">About Us</h1>
    <p>{aboutIntroduction}</p>
  </div>
</section>
<style>
  .about-hero {
    position: relative;
    min-height: var(--about-hero-height);
    display: grid;
    place-items: center;
    color: var(--color-white);
    text-align: center;
  }
  .hero-photo,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-photo {
    object-fit: cover;
  }
  .hero-shade {
    background: var(--hero-shade);
  }
  .hero-copy {
    position: relative;
    padding-block: var(--space-xl);
  }
  h1 {
    font-size: var(--text-about-hero);
    line-height: var(--leading-about-hero);
    font-weight: var(--font-weight-normal);
    margin-bottom: var(--space-lg);
  }
  p {
    max-width: var(--about-introduction-max);
    font-size: var(--text-content-lead);
    margin: auto;
  }
</style>
